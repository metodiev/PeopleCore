# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api
API_VERSION=1
WEB_APP_URL=http://localhost:5173

# ─── Database ────────────────────────────────────────────────────────────────
# Production/staging: PostgreSQL connection string.
# Local development without Docker: set DATABASE_DRIVER=pglite (embedded Postgres in WASM).
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://peoplecore:peoplecore@localhost:5432/peoplecore
# Optional: separates the shadow database used by `prisma migrate dev`.
SHADOW_DATABASE_URL=
# Embedded Postgres (DATABASE_DRIVER=pglite): data directory location.
# Use "memory" for a throwaway database (tests, CI). Default: ./.pgdata
PGLITE_DATA_DIR=./.pgdata
# Flush the embedded database to disk on every write (durable, ~10x slower).
PGLITE_SYNC_TO_FS=false

# ─── Redis (queues, cache, rate limiting) ────────────────────────────────────
# Leave empty to run background jobs inline (development/testing only).
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# AES-256-GCM key (base64, 32 bytes) used to encrypt secrets at rest
# (MFA secrets, OAuth tokens, IBAN/ID numbers). Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# ─── Email ───────────────────────────────────────────────────────────────────
MAIL_DRIVER=console
MAIL_FROM="PeopleCore <no-reply@peoplecore.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ─── File storage ────────────────────────────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/documents
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Seconds a presigned URL stays valid
S3_SIGNED_URL_TTL=900

# ─── OAuth / SSO (optional — endpoints stay disabled when unset) ─────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/v1/integrations/microsoft/callback

# Enterprise SSO / SAML (metadata kept in tenant settings; secrets here)
SAML_CERTIFICATE=

# ─── Mobile push (Expo) ──────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ─── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=

# ─── Backups / retention ─────────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
